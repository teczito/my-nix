@@ -0,0 +1,130 @@
+//! Kernel-level keyboard emulation through /dev/uinput.
+//!
+//! Keys sent through `zwp_virtual_keyboard_v1` are forwarded by some compositors
+//! (e.g. smithay-based ones such as niri) directly to the focused client, which
+//! bypasses the compositor's own keybindings and its xkb modifier state. A uinput
+//! device instead shows up as a real evdev keyboard, so the compositor handles it
+//! exactly like the built-in one: bindings, AltGr / level3, layouts and repeat.
+
+use std::fs::{File, OpenOptions};
+use std::io::{self, Write};
+use std::os::fd::AsRawFd;
+use std::os::raw::{c_int, c_ulong};
+
+unsafe extern "C" {
+    fn ioctl(fd: c_int, request: c_ulong, ...) -> c_int;
+}
+
+// linux/uinput.h
+const UI_DEV_CREATE: c_ulong = 0x5501;
+const UI_DEV_DESTROY: c_ulong = 0x5502;
+const UI_DEV_SETUP: c_ulong = 0x405c5503; // _IOW('U', 3, struct uinput_setup)
+const UI_SET_EVBIT: c_ulong = 0x40045564; // _IOW('U', 100, int)
+const UI_SET_KEYBIT: c_ulong = 0x40045565; // _IOW('U', 101, int)
+
+// linux/input-event-codes.h
+const EV_SYN: u16 = 0x00;
+const EV_KEY: u16 = 0x01;
+const SYN_REPORT: u16 = 0;
+const BUS_VIRTUAL: u16 = 0x06;
+/// Keyboard keys only: everything below BTN_MISC (0x100), so libinput
+/// classifies the device as a keyboard and not as a pointer.
+const MAX_KEY: c_int = 0xff;
+
+#[repr(C)]
+struct InputId {
+    bustype: u16,
+    vendor: u16,
+    product: u16,
+    version: u16,
+}
+
+#[repr(C)]
+struct UinputSetup {
+    id: InputId,
+    name: [u8; 80],
+    ff_effects_max: u32,
+}
+
+#[repr(C)]
+struct InputEvent {
+    tv_sec: i64,
+    tv_usec: i64,
+    type_: u16,
+    code: u16,
+    value: i32,
+}
+
+pub(crate) struct UinputKeyboard {
+    file: File,
+}
+
+fn check(ret: c_int) -> io::Result<()> {
+    if ret < 0 {
+        Err(io::Error::last_os_error())
+    } else {
+        Ok(())
+    }
+}
+
+impl UinputKeyboard {
+    pub(crate) fn new() -> io::Result<Self> {
+        let file = OpenOptions::new().write(true).open("/dev/uinput")?;
+        let fd = file.as_raw_fd();
+        let mut setup = UinputSetup {
+            id: InputId {
+                bustype: BUS_VIRTUAL,
+                vendor: 0x4c4d, // "LM"
+                product: 0x0001,
+                version: 1,
+            },
+            name: [0; 80],
+            ff_effects_max: 0,
+        };
+        let name = b"lan-mouse virtual keyboard";
+        setup.name[..name.len()].copy_from_slice(name);
+        unsafe {
+            check(ioctl(fd, UI_SET_EVBIT, EV_KEY as c_int))?;
+            check(ioctl(fd, UI_SET_EVBIT, EV_SYN as c_int))?;
+            for key in 1..=MAX_KEY {
+                check(ioctl(fd, UI_SET_KEYBIT, key))?;
+            }
+            check(ioctl(fd, UI_DEV_SETUP, &setup as *const UinputSetup))?;
+            check(ioctl(fd, UI_DEV_CREATE))?;
+        }
+        Ok(Self { file })
+    }
+
+    fn emit(&mut self, type_: u16, code: u16, value: i32) -> io::Result<()> {
+        let ev = InputEvent {
+            tv_sec: 0,
+            tv_usec: 0,
+            type_,
+            code,
+            value,
+        };
+        let bytes = unsafe {
+            std::slice::from_raw_parts(
+                &ev as *const InputEvent as *const u8,
+                std::mem::size_of::<InputEvent>(),
+            )
+        };
+        self.file.write_all(bytes)
+    }
+
+    pub(crate) fn key(&mut self, key: u32, state: u8) -> io::Result<()> {
+        if key == 0 || key > MAX_KEY as u32 {
+            return Ok(());
+        }
+        self.emit(EV_KEY, key as u16, if state == 0 { 0 } else { 1 })?;
+        self.emit(EV_SYN, SYN_REPORT, 0)
+    }
+}
+
+impl Drop for UinputKeyboard {
+    fn drop(&mut self) {
+        unsafe {
+            ioctl(self.file.as_raw_fd(), UI_DEV_DESTROY);
+        }
+    }
+}
